[node name="DocumentoRondante" type="StaticBody3D"]
script = ExtResource("1_docrond")
documento_id = &"diario_celeiro"
titulo_documento = "Anotações do Celeiro"
subtitulo_data = "REGISTRO DE VIGIA — ENCONTRADO PERTO DO PORTÃO"
texto_conteudo = "RELATÓRIO SOBRE A CRIATURA QUE RONDA O TERRENO:

1. Ela não enxerga bem à distância, mas ouve tudo. Correr, bater portas ou errar o conserto das bombas atrai sua atenção imediatamente para o local do barulho.

2. Costuma parar nas quinas do celeiro e do silo para espiar antes de avançar. Se ouvir passos pesados se aproximando, apague a lanterna e entre em um armário ou abrigo sem fazer ruído.

3. Se ficar encurralado, aponte o feixe direto nos olhos dela por um instante para deixá-la desnorteada — mas lembre-se: usar luz demais desperta a outra sombra."
prompt_interacao = "Ler Anotações do Celeiro"

