[node name="DocumentoMesa" type="StaticBody3D"]
script = ExtResource("1_docscript")
documento_id = &"bilhete_caseiro"
titulo_documento = "Bilhete do Antigo Caseiro"
subtitulo_data = "ANOTAÇÃO MANUSCRITA — DEIXADA NA MESA"
texto_conteudo = "Para quem assumir a vigília:

1. Nunca ignore o silêncio atrás de você depois que o sol cair. Se sentir o ar pesado, olhe rápido para trás [Q] sem a lanterna ligada — ela não suporta ser observada no escuro.

2. Se a sua lanterna começar a piscar enquanto olha para o vulto, DESLIGUE [F] imediatamente. A luz direta alimenta a fúria dela.

3. O abrigo de madeira lá fora segura a investida dela, mas só funciona se você permanecer no escuro. Se acender a lanterna lá dentro, ela saberá exatamente onde você está."
prompt_interacao = "Ler Bilhete"

